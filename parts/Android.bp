android_app {
    name: "XiaomiParts",
    defaults: [
        "SettingsLibDefaults",
    ],

    init_rc: ["init.xiaomiparts.rc"],
    srcs: [
        "src/**/*.kt",
        "src/**/*.java"
    ],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.preference_preference"
    ],
}
